{
  "name": "fat-xp",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd apps/api && uvicorn api:app --reload --port 8000",
    "dev:web": "npm run dev -w apps/web",
    "test:api": "cd apps/api && pytest -q",
    "test:web": "npm run smoke -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "check": "npm run test:api && npm run test:web && npm run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
